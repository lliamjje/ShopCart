# Ejecutar desde backend/. Copiar a .env local (ignorado por Git).
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# TCP/IP de SQLEXPRESS: no depender de SQL Server Browser.
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=ShopCart
# Cuenta de servicio con permisos mínimos: pendiente de configurar por separado.
SQL_USER=shopcart_service
SQL_PASSWORD=
SQL_ENCRYPT=true
# Excepción solo en localhost y desarrollo.
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECT_TIMEOUT_MS=5000
SQL_REQUEST_TIMEOUT_MS=15000
CORS_ORIGIN=http://127.0.0.1:5173
# Generar fuera del repositorio, mínimo 32 caracteres aleatorios.
JWT_SECRET=
ACCESS_TOKEN_SECONDS=600
SESSION_DAYS=7
# Cookies host-only; SameSite=Strict; Secure en producción.
# Frontend: credentials=include, obtener /auth/csrf y enviar X-CSRF-Token al mutar.
# JWT access solo en Authorization: Bearer; no se almacena en cookies.
# Los 012-020 deben instalarse manualmente: el arranque NO conecta ni migra.
# Todos los importes HTTP son strings de hasta 4 decimales. Límite conservador
# del adaptador Number del driver: |importe| <= 1,000,000,000 GTQ; fuera: error,
# nunca una respuesta monetaria silenciosamente redondeada. SQL calcula totales.
# Usar el MISMO hostname en frontend/API (por ejemplo 127.0.0.1), para SameSite=Strict.
# Fechas de filtros: UTC Z con precisión máxima de milisegundos.
# La revisión del carrito es texto ISO de SQL, sin convertirla a Date de JavaScript.
