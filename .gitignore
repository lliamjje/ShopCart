
# ==========================================
# ShopCart - Git Ignore
# ==========================================

# Dependencias de Node.js
node_modules/
**/node_modules/

# Variables de entorno y credenciales
.env
.env.*
!.env.example
!**/.env.example

# Compilacion y archivos generados
dist/
build/
out/
coverage/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos temporales
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

# Adicional
AGENTS.md

# Pruebas y reportes generados
test-results/
playwright-report/
.nyc_output/

# Cachés
.cache/
.parcel-cache/
.vite/
.eslintcache

# Archivos locales de SQL Server
*.mdf
*.ldf
*.ndf

# Archivos de respaldo de base de datos
*.bak
*.bacpac
